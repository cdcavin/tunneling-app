{
  // Cloudflare Worker config: serves the built site from dist/ and the data API from KV.
  "name": "wvu-tunneling",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/data/*", "/api/*"]
  },
  "kv_namespaces": [
    { "binding": "DATA", "id": "07dec3dd433e4b378bd5e29fb50aa769" }
  ]
}
